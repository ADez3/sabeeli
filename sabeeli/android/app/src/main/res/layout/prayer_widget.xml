<?xml version="1.0" encoding="utf-8"?>
<!-- The next prayer: a quiet line, the name large, its time in dawn amber.
     The sample texts only show in the widget picker, before the app fills it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/widget_caption"
        android:text="@string/widget_sample_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#A6AEC6"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_name"
        android:text="@string/widget_sample_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:maxLines="1"
        android:textColor="#EEF1F8"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/widget_time"
        android:text="@string/widget_sample_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#F4B56A"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/widget_then"
        android:text="@string/widget_sample_then"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:textColor="#6E7693"
        android:textSize="12sp" />
</LinearLayout>
